# Copy to .env for local development. NEVER commit the real file.
#
# In CI this whole file is stored as the DOTENV secret on each GitHub
# Environment, and written to disk before the build.
#
# FORMAT RULES -- each of these has broken a real deployment:
#   KEY=value          no spaces around '='  (Docker and the shell do not trim)
#   quotes balanced    'value with no closing quote makes Docker reject the file
#   no stray spaces    a key with a trailing space fails authentication
#   Unix line endings  CRLF puts an invisible character on every value
# Run shared/scripts/validate-env.sh to check a file before pasting it in.

# --- application ---------------------------------------------------------
# Whatever the app itself reads. NEXT_PUBLIC_* values are compiled into the
# browser bundle at BUILD time -- they are public, and changing one needs a
# rebuild, not a restart.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- deployment ----------------------------------------------------------
# Local only; in CI these come from GitHub Environment variables.
APP_NAME=myapp
COMPOSE_PROJECT_NAME=myapp_local
PORT=8080

# Set BOTH only if an API must be reached directly instead of through a CDN.
# See "Reaching the API directly" in deployment.md.
API_HOST=api.example.com
API_ORIGIN_IP=203.0.113.10
